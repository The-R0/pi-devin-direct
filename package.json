{
  "name": "@the-r0/pi-devin-direct",
  "version": "0.1.0",
  "description": "A native Devin provider for Pi, supporting standalone browser authentication and existing Devin Desktop/CLI credentials, with no mandatory Devin installation.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "devin",
    "devin-local",
    "cognition",
    "swe-2",
    "custom-provider"
  ],
  "author": "Kashyab Ambarani",
  "contributors": [
    "mizorewww",
    "The-R0"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-R0/pi-devin-direct.git"
  },
  "homepage": "https://github.com/The-R0/pi-devin-direct#readme",
  "bugs": {
    "url": "https://github.com/The-R0/pi-devin-direct/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "extensions/",
    "src/",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "smoke": "tsx probe/smoke.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
